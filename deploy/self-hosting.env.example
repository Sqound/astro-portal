# Copy outside the checkout, chmod 600, then replace every REPLACE_ME value.
# Create portal/next-cache/ as your own user; use id -u and id -g for the two IDs below.
# docker compose --env-file /path/to/data/portal.env up -d --build
ASTRO_PORTAL_DATA_DIR='/path/to/astro-portal-data'
ASTRO_PORTAL_UID=1001
ASTRO_PORTAL_GID=1001
PORT=8787
ASTRO_PORTAL_AUTH_MODE=password
# openssl rand -hex 32 (URL-safe PostgreSQL password)
POSTGRES_PASSWORD=REPLACE_ME
# openssl rand -base64 32
ASTRO_PORTAL_SIGN_IN_KEY=REPLACE_ME
ASTRO_PORTAL_BOOTSTRAP_SECRET=REPLACE_ME
# Behind a tunnel or a reverse proxy on this machine: publish the port on
# 127.0.0.1 only, and give the public address and the client header
# (docs/SELF_HOSTING.md, « Reverse proxy or tunnel »).
# ASTRO_PORTAL_BIND_ADDRESS=127.0.0.1
# ASTRO_PORTAL_PUBLIC_URL=https://portal.example.test
# ASTRO_PORTAL_CLIENT_IP_HEADER=cf-connecting-ip
