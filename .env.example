# Astro Portal — an environment file for the service (docs/SELF_HOSTING.md).
# Keep the real one outside the repository, readable by the service alone
# (chmod 600), and start the service with `node --env-file=<file> …`.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# Your private data, outside the repository and the releases.
ASTRO_PORTAL_DATABASE_PATH=/srv/astro-portal/private/portal.sqlite
ASTRO_PORTAL_RUNTIME_DIR=/srv/astro-portal/runtime
# ASTRO_PORTAL_IMAGES_DIR=/srv/astro-portal/images
# ASTRO_PORTAL_METADATA_DIR=/srv/astro-portal/catalog

# The sign-in of a private server: `password` or `email-code`
# (docs/PRIVATE_NOTEBOOK_AUTH.md). Both need the key of the sign-in
# (`openssl rand -base64 32`) and, once, the bootstrap secret typed at
# /auth/bootstrap.
ASTRO_PORTAL_AUTH_MODE=password
ASTRO_PORTAL_SIGN_IN_KEY=
ASTRO_PORTAL_BOOTSTRAP_SECRET=

# For `email-code`: the address of the portal and a mail server.
# ASTRO_PORTAL_AUTH_MODE=email-code
# ASTRO_PORTAL_PUBLIC_URL=https://portal.example.org
# ASTRO_PORTAL_MAIL_SENDER=smtp
# ASTRO_PORTAL_SMTP_URL=smtps://you%40example.org:app-password@smtp.example.org:465
# ASTRO_PORTAL_MAIL_FROM=you@example.org

# A server of the local network only, never exposed to the Internet, opened
# over plain http: keep the web session without https.
# ASTRO_PORTAL_COOKIE_SECURE=false

# Behind a reverse proxy or a tunnel that alone reaches the service.
# ASTRO_PORTAL_CLIENT_IP_HEADER=cf-connecting-ip

# The administration from the local network, besides localhost.
# ASTRO_PORTAL_ADMIN_ALLOWED_IPS=192.168.1.0/24

# Hourly backups, kept 14 days.
# ASTRO_PORTAL_BACKUP_MAX_AGE_DAYS=14
