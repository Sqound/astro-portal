            "points": [{ "altitude": 5, "azimuth": 0 }]
          },
          "latitude": 45.5,
          "longitude": -73.6
        }
      ]
    },
    {
      "id": "invalid-coordinates-fingerprint-as-null",
      "args": [{ "latitude": "", "longitude": "" }]
