{
  "module": "change-signal",
  "package": "astro-contracts",
  "export": "parseChangeSignalEvent",
  "cases": [
    {
      "id": "change-single-domain",
      "args": ["change", { "cursor": "boot-1:0", "domains": ["plans"] }]
    },
    {
      "id": "change-multiple-domains-preserves-order",
      "args": [
        "change",
        { "cursor": "boot-1:42", "domains": ["captures", "plans", "devices"] }
      ]
    },
    { "id": "resync-event", "args": ["resync", { "cursor": "boot-1:7" }] },
    {
      "id": "cursor-zero-sequence-is-valid",
      "args": ["change", { "cursor": "abc:0", "domains": ["devices"] }]
    },
    {
      "id": "unknown-event-name-rejected",
      "args": ["ping", { "cursor": "boot-1:0" }]
    },
    { "id": "non-object-payload-rejected", "args": ["change", null] },
    { "id": "array-payload-rejected", "args": ["change", []] },
    {
      "id": "missing-cursor-rejected",
      "args": ["change", { "domains": ["plans"] }]
    },
    {
      "id": "malformed-cursor-no-colon-rejected",
      "args": ["change", { "cursor": "boot-1", "domains": ["plans"] }]
    },
    {
      "id": "malformed-cursor-leading-zero-rejected",
      "args": ["resync", { "cursor": "boot-1:01" }]
    },
    {
      "id": "change-missing-domains-rejected",
      "args": ["change", { "cursor": "boot-1:0" }]
    },
    {
      "id": "change-extra-field-rejected",
      "args": [
        "change",
        { "cursor": "boot-1:0", "domains": ["plans"], "originDeviceId": "d1" }
      ]
    },
    {
      "id": "resync-with-domains-rejected",
      "args": ["resync", { "cursor": "boot-1:0", "domains": ["plans"] }]
    },
    {
      "id": "empty-domains-rejected",
      "args": ["change", { "cursor": "boot-1:0", "domains": [] }]
    },
    {
      "id": "unknown-domain-rejected",
      "args": ["change", { "cursor": "boot-1:0", "domains": ["catalogue"] }]
    },
    {
      "id": "change-projects-domain",
      "args": ["change", { "cursor": "boot-1:3", "domains": ["projects"] }]
    },
    {
      "id": "change-projects-with-plans",
      "args": [
        "change",
        { "cursor": "boot-1:4", "domains": ["plans", "projects"] }
      ]
    },
    {
      "id": "duplicate-projects-domain-rejected",
      "args": [
        "change",
        { "cursor": "boot-1:5", "domains": ["projects", "projects"] }
      ]
    },
    {
      "id": "duplicate-domain-rejected",
      "args": [
        "change",
        { "cursor": "boot-1:0", "domains": ["plans", "plans"] }
      ]
    }
  ]
}
