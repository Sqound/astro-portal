{
  "contract": "place.schema.json",
  "description": "The matrix of the most recent edit, replayed by the service's tests against the real routes and readable by the clients' fakes. Each case starts from an empty space and plays its steps in order; `now` is the service's clock at that step. `placeId: \"A\"` names the place `5f0c1d2e-3a4b-4c5d-8e6f-7a8b9c0d1e2f`; a step's `body` is completed with the base point (`latitude` 45, `longitude` -30). A `PUT` of a place carries `name` and `editedAt`; a `DELETE` carries `at` as `?at=` (absent: the service's clock); `path: \"default\"` is `PUT /v1/places/default`; a `GET` without `placeId` is the list. `expect` names only what the step checks: `status`, `applied`/`deleted`, the kept `name` and `editedAt` (or `place: null`), the error `code`, the list's `placeIds` and `defaultPlaceId`. The service caps an instant at its clock + 5 minutes, keeps a tombstone 90 days after the deletion's instant, and refuses to create a place from an edit older than that.",
  "base": {
    "placeId": "5f0c1d2e-3a4b-4c5d-8e6f-7a8b9c0d1e2f",
    "latitude": 45,
    "longitude": -30
  },
  "rule": {
    "clockCapMinutes": 5,
    "tombstoneDays": 90
  },
  "cases": [
    {
      "id": "create-then-newer-edit",
      "description": "A creation (201), then a more recent edit: kept.",
      "steps": [
        {
          "now": "2026-10-09T12:00:00.000Z",
          "request": {
            "method": "PUT",
            "placeId": "A",
            "body": {
              "name": "Col des Étoiles",
              "editedAt": "2026-10-09T11:50:00.000Z"
            }
          },
          "expect": {
            "status": 201,
            "applied": true,
            "name": "Col des Étoiles",
            "editedAt": "2026-10-09T11:50:00.000Z"
          }
        },
        {
          "now": "2026-10-09T12:00:00.000Z",
          "request": {
            "method": "PUT",
            "placeId": "A",
            "body": {
              "name": "Col des Étoiles (parking)",
              "editedAt": "2026-10-09T11:55:00.000Z"
            }
          },
          "expect": {
            "status": 200,
            "applied": true,
            "name": "Col des Étoiles (parking)",
            "editedAt": "2026-10-09T11:55:00.000Z"
          }
        }
      ]
    },
